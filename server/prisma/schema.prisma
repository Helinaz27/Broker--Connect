generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//  COLLECTIONS 

// 2.1 Users Collection
model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName        String
  lastName         String
  phone            String
  email            String    @unique
  password     String
  roles            Role[]
  coins            Int       @default(0)
  isActive         Boolean   @default(true)
  isKYCVerified  Boolean   @default(false)
  profileImage     String?
  kycRequests      KYCRequest[]
   payments         Payment[] 
  coinTransactions CoinTransaction[]
  houseListings    HouseListing[]    // ✅ added
  carListings      CarListing[]      // ✅ added
  serviceListings  serviceListing[]  // ✅ added
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")
}

// 2.2 KYC Requests Collection
model KYCRequest {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  userId           String         @db.ObjectId
  documentType     DocumentType
  documentNumber   String
  frontSideImage       String
  backSideImage        String?
  status           KYCStatus      @default(pending)
  reviewedBy       String?        @db.ObjectId
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id])
}


// 2.3 House Listings Collection
model HouseListing {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  ownerId          String         @db.ObjectId
  title            String
  description      String
  listingMode      ListingMode
  houseType        HouseType
  images           String[]
  price            Float
  rentalPeriod     Period?
  bedrooms         Int
  bathrooms        Int
  area_sqm         Int
  tanker           Boolean
  parking          Int
  location         LocationData
  contactCoinLimit Int
  postingFeeId     String?        @db.ObjectId
  paidUntil        DateTime?
  status           ListingStatus  @default(active)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  owner            User           @relation(fields: [ownerId], references: [id]) // ✅ added
  @@map("house_listings")
}

// 2.4 Car Listings Collection
model CarListing {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  ownerId          String         @db.ObjectId
  title            String
  description      String
  listingMode      ListingMode
  carType          CarType
  condition        carConditionType
  brand            String
  model            String
  images           String[]
  Price            Float
  rentalPeriod     Period
  location         LocationData
  contactCoinLimit Int
  postingFeeId     String?        @db.ObjectId
  paidUntil        DateTime?
  status           ListingStatus  @default(active)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  owner            User           @relation(fields: [ownerId], references: [id]) // ✅ added

  @@map("car_listings")
}

// 2.5 Service Listings Collection
model serviceListing {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  ownerId          String         @db.ObjectId
  title            String
  serviceType      ServiceType
  description      String
  images           String[]
  price            Float
  location         LocationData
  contactCoinLimit Int
  postingFeeId     String?        @db.ObjectId
  paidUntil        DateTime?
  status           ListingStatus  @default(active)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  owner            User           @relation(fields: [ownerId], references: [id]) // ✅ added

  @@map("service_listings")
}

// 2.6 Posting Fees Collection
model PostingFee {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  category        ListingCategory
  listingMode     ListingMode?
  durationDays    Int
  price           Float
  description     String?
  isActive        Boolean        @default(true)
  updatedAt       DateTime?
  createdBy       String         @db.ObjectId
  createdAt       DateTime       @default(now())

  @@map("posting_fees")
}

// 2.7 Payments Collection
model Payment {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  userId          String         @db.ObjectId
  amountBirr      Float
  coinsReceived   Int
  paymentMethod   PaymentMethod
  transactionId   String         @unique
  status          PaymentStatus  @default(pending)
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
   user            User           @relation(fields: [userId], references: [id]) 

  @@map("payments")
}

// 2.8 Coin Transactions Collection
model CoinTransaction {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  userId          String         @db.ObjectId
  type            TransactionType
  amount          Int
  Reason          CoinReason
  description     String?
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id]) 

  @@map("coin_transactions")
}

// 2.9 Chat Rooms Collection
model ChatRoom {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  participants    String[]       @db.ObjectId
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("chat_rooms")
}

// 2.10 Messages Collection
model Message {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  roomId          String         @db.ObjectId
  senderId        String         @db.ObjectId
  listingId       String         @db.ObjectId
  listingType     ListingType
  messageType     MessageType    @default(text)
  content         String
  readBy          ReadReceipt[]
  createdAt       DateTime       @default(now())

  @@map("messages")
}

// 2.11 Notifications Collection
model Notification {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  userId          String         @db.ObjectId
  Type            NotificationType
  title           String
  body            String
  data            NotificationData?
  isRead          Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([userId])
  @@index([createdAt])

  @@map("notifications")
}

// 2.12 Contact Access Collection
model ContactAccess {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  viewerId        String         @db.ObjectId
  ownerId         String         @db.ObjectId
  listingId       String         @db.ObjectId
  listingType     ListingType
  coinsPaid       Int
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@map("contact_accesses")
}


//  ENUMS 
enum Role {
  
  user
  Service_provider 
  admin
  
}

enum DocumentType {
  national_id
  passport
  driving_license

}

enum KYCStatus {
  pending
  approved
  rejected
}

enum HouseType {
  condominium
  villa
  business
  apartment
  others
}

enum  Period {
  daily
  weekly
  monthly
  yearly
}
enum ListingType {
  car
  house
  service
}

enum ListingMode{
  rent
  sell
}



enum CarType {
  electric
  fuel
}

enum carConditionType {
  used
  new

}

enum ServiceType {
  electrician
  plumber
  catering
  house_worker
  other
}

enum ListingStatus {
  active
  inactive
  occupied
  sold
  done
}

enum ListingCategory {
  house
  car
  othersservice
}

enum PaymentMethod {
  telebirr
  CBE
}

enum PaymentPurpose {
  buy_coins
}

enum PaymentStatus {
  pending
  success
  failed
}

enum TransactionType {
  credit
  debit
}

enum CoinReason {
  kyc_bonus
  welcome_bonus
  purchase
  posting_fee
  contact_access
  user_transfer
  refund
}

enum MessageType {
  text
  image
  file
}

enum NotificationType {
  message
  payment_success
  kyc_approved
  kyc_rejected
  post_expired
  insufficient_coins
  new_contact
  system
}

//  EMBEDDED TYPES 
type Coordinates {
  lat Float
  lng Float
}

type LocationData {
  city        String
  subCity     String?
  placeName   String?
  coordinates Coordinates?
}

type ReadReceipt {
  userId  String @db.ObjectId
  readAt  DateTime
}

type NotificationData {
  path        String?
  referenceId String? @db.ObjectId
}